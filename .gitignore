# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# transient tsc output for the no-dependency node test scripts
.test-build/
.pdfsmoke-test-build/

# pdf smoke-render output (scripts/pdf-smoke.tsx)
.smoke-pdfs/
.claude/worktrees/

.vercel
.env*.local

# pdf-fidelity harness output (scripts/pdf-fidelity.mjs)
.fidelity-pdfs/
.pdf-fidelity-build/

# perf measurements (scripts/perf-measure.mjs)
/.perf-results
