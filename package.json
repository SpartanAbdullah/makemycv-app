{
  "name": "makemycv-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=11",
    "test": "node scripts/run-all-tests.mjs",
    "test:unit": "tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\"",
    "test:parser": "tsc -p tsconfig.test.json && node scripts/parser-fixtures.test.cjs",
    "smoke:pdf": "tsc scripts/pdf-smoke.tsx --outDir .pdfsmoke-test-build --module commonjs --target es2020 --esModuleInterop --skipLibCheck --jsx react-jsx && node .pdfsmoke-test-build/scripts/pdf-smoke.js",
    "capture:previews": "node scripts/capture-previews.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@react-pdf/renderer": "^4.3.2",
    "@react-pdf/types": "^2.9.2",
    "@sentry/nextjs": "^10.69.0",
    "@upstash/ratelimit": "^2.0.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "docx": "^9.0.0",
    "mammoth": "^1.8.0",
    "nanoid": "^5.1.9",
    "next": "16.1.6",
    "pdfjs-dist": "^4.4.168",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
