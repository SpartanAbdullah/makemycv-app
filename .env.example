# Claude API — used by /api/ai-improve and /api/resume-checker/parse
ANTHROPIC_API_KEY=

# Global daily AI spend cap shared by ALL Claude-proxy routes, in "units"
# (parse = 3 units, ai-improve / jd-match / rewrite-bullet = 1 each).
# Optional — defaults to 1500 units/day. See lib/server/spendGuard.ts.
AI_DAILY_GLOBAL_CAP=1500

# Vercel KV — used to store ATS report payloads with 24h TTL AND to back the
# per-IP rate limit on /api/ai-improve via @upstash/ratelimit.
# Pull these locally with: vercel env pull .env.local
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Ko-fi username — PRIMARY tip rail. Used to build https://ko-fi.com/<username>.
# Defaults to "makemycv_ae" (note the underscore) if unset.
# See DECISION_LOG.md 2026-05-31 (final tip surface: Ko-fi primary).
#
# REQUIRED Ko-fi DASHBOARD SETTINGS (not enforceable from code — verify
# manually at ko-fi.com/manage whenever the page settings change):
#   - Default tip amount: $3
#   - Minimum tip amount: $1
#   - Supporter list / contributor visibility toggle: OFF
#   - Wording: "Tip" (never "donation" / "membership")
NEXT_PUBLIC_KOFI_USERNAME=makemycv_ae

# PayPal handle — SECONDARY tip rail. Used to build https://paypal.me/<handle>.
# Defaults to "Abdullah2431" if unset.
# See DECISION_LOG.md 2026-05-31 (free + voluntary support pivot).
NEXT_PUBLIC_PAYPAL_ME_HANDLE=Abdullah2431

# Sentry error tracking — https://abdullah-bsw.sentry.io/ project "makemycv-app".
# Org is on Sentry's EU region (note the .de. in the ingest host), which is why
# the CSP connect-src in next.config.ts allows *.ingest.de.sentry.io and not
# the US host. Pull the real values with: vercel env pull .env.local
#
# The DSN is public by design — it ships in the client bundle, which is why it
# carries the NEXT_PUBLIC_ prefix. It is not a secret; it only allows sending
# events INTO this project. SENTRY_ORG/PROJECT are build-time only, used by
# withSentryConfig for source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=abdullah-bsw
SENTRY_PROJECT=makemycv-app

# Sentry source-map upload token. Build-time only, NEVER exposed to the client.
# Create at: Settings > Developer Settings > Auth Tokens (scope: project:releases)
SENTRY_AUTH_TOKEN=

# Google Tag Manager container — the SAME container id the marketing site uses.
# One container, one data stream, deliberately: app.makemycv.ae and
# www.makemycv.ae share the root domain makemycv.ae, so sessions stitch
# automatically. Do NOT create a second GA4 property or stream for this host.
#
# This is the GTM CONTAINER id (GTM-…), NOT the GA4 measurement id
# (G-8MWPD87FJH) — GA4 is configured inside the container. Putting a G- id here
# requests a container that does not exist and silently kills all analytics.
#
# LEAVE THIS EMPTY, HERE AND IN .env.local. It is set ONLY in Vercel → Settings →
# Environment Variables, scoped to the Production environment (Preview and
# Development unchecked), so local and preview runs cannot pollute production data.
#
# Requires the googletagmanager / google-analytics entries in the next.config.ts
# CSP — without them the browser blocks the tag and it fails silently.
#
# Production value: GTM-5H2LMVJT
NEXT_PUBLIC_GTM_ID=
